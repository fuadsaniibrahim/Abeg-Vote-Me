# Copy to .env. Every value is optional in development.
NODE_ENV=development
PORT=4000
# Leave DATABASE_URL unset to use the embedded PGlite database in ./.pglite
# DATABASE_URL=postgres://avm:avm@localhost:5432/avm
# PGLITE_DIR=./.pglite
# REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:5173
WORLD_SEED=abeg-vote-me-season-1
# Required in production (16+ chars)
COOKIE_SECRET=dev-only-cookie-secret-change-me
