{
  "name": "abeg-vote-me",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c green,cyan \"npm run dev -w @avm/server\" \"npm run dev -w @avm/web\"",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "seed": "npm run seed -w @avm/server",
    "verify-tasks": "node scripts/verify-tasks.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "concurrently": "^9.2.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
